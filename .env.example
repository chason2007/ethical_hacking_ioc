# Application Environment Variables
APP_NAME="Packet Analysis of Common Network Protocols"
DEBUG=True

# Database Configuration
# Default: Local SQLite (Zero setup, perfect for local demo & evaluation)
DATABASE_URL=sqlite:///./network_analysis.db

# Production PostgreSQL configuration alternative:
# DATABASE_URL=postgresql://user:password@localhost:5432/netprotocol_db

# File limits
MAX_UPLOAD_SIZE_MB=50
